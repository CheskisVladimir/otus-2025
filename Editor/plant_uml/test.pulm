@startuml

class Vector {
  - data: double*
  - size: int
  + Vector()
  + Vector(size: int)
  + ~Vector()
  + push_back(value: double): void
  + at(index: int): double
}

class Matrix {
  - rows: int
  - cols: int
  - data: Vector*
  + Matrix(rows: int, cols: int)
  + ~Matrix()
  + get(row: int, col: int): double
  + set(row: int, col: int, value: double): void
}

Matrix *-- Vector


@startuml

class ClassA {
  - classBRef : shared_ptr<ClassB>
  + methodA()
}

class ClassB {
  - classARef : weak_ptr<ClassA>
  + methodB()
}

ClassA --> ClassB : shared_ptr
ClassB ..> ClassA : weak_ptr

@enduml

@enduml